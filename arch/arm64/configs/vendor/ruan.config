# ruan (Redmi Pad Pro 5G / POCO Pad 5G) on top of parrot_perf.config.
#
# First goal is a kernel that reaches Android userspace with storage, display
# and USB. Device drivers (speaker amps, IR, sensors, hall, pen) come later,
# one at a time, as source ports.
CONFIG_LOCALVERSION="-ruan"
# CONFIG_LOCALVERSION_AUTO is not set

# BTF needs the resolve_btfids host tool, whose libbpf fails against newer
# host glibc headers. Not needed for bring-up.
# CONFIG_DEBUG_INFO_BTF is not set
