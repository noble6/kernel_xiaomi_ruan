# ruan (Redmi Pad Pro 5G / POCO Pad 5G) on top of parrot_consolidate.config.
#
# First goal is a kernel that reaches Android userspace with storage, display
# and USB. Device drivers (speaker amps, IR, sensors, hall, pen) come later,
# one at a time, as source ports.
CONFIG_LOCALVERSION="-ruan"
# CONFIG_LOCALVERSION_AUTO is not set
